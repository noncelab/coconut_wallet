desc "배포 전에 실행하는 공통 함수"
lane :pre_deploy do
    check_electrum_cert_fingerprints_date

    # 현재 디렉토리 확인
    sh "echo '=== Current Directory ==='; pwd"

    # app_info.dart 파일의 RELEASE_DATE 변경
    update_app_info()

    Dir.chdir("..") do
        sh "fvm flutter pub get"
        sh "fvm flutter pub run flutter_oss_licenses:generate"
        sh "fvm flutter pub run build_runner clean"
        sh "fvm flutter pub run build_runner build --delete-conflicting-outputs"
        sh "echo '=== Before realm generate: Current Directory ==='"
        sh "pwd"
        sh "fvm dart run realm generate"
        sh "fvm flutter pub run slang"
        sh "fvm dart format . --line-length=120"
    end
end

private_lane :check_electrum_cert_fingerprints_date do
    last_run_file = "../.agents/skills/check-electrum-cert-fingerprints/last_run.txt"
    today = Time.now.strftime("%Y-%m-%d")

    if File.exist?(last_run_file)
        last_run = File.read(last_run_file).strip
        if last_run != today
            UI.user_error!(
                "Electrum certificate fingerprint check was last run on #{last_run}. " \
                "Please run '/check-electrum-cert-fingerprints' today before deploying."
            )
        else
            UI.success("Electrum certificate fingerprint check was run today (#{today}).")
        end
    else
        UI.user_error!(
            "Electrum certificate fingerprint check has never been recorded. " \
            "Please run '/check-electrum-cert-fingerprints' before deploying."
        )
    end
end
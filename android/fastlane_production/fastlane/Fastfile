# frozen_string_literal: true

default_platform(:android)

require "open3"
require "shellwords"
require_relative "../../../fastlane/shared/pubspec_helper"
require_relative "../../../fastlane/shared/util_helper"
require_relative "../../../fastlane/production/release_helper"

ROOT_DIR = File.expand_path("../../..", __dir__)
ANDROID_PACKAGES = {
  "mainnet" => "onl.coconut.wallet",
  "regtest" => "onl.coconut.wallet.regtest"
}.freeze

def production_android_signing_property(properties_file, key)
  line = File.readlines(properties_file, chomp: true).find do |candidate|
    candidate.match?(/^\s*#{Regexp.escape(key)}\s*=/)
  end
  line&.split("=", 2)&.last&.strip
end

def validate_production_android_signing_password(flavor:, password:)
  properties_file = File.join(ROOT_DIR, "android", "key_#{flavor}.properties")
  UI.user_error!("Keystore properties file not found: #{properties_file}") unless File.file?(properties_file)

  key_alias = production_android_signing_property(properties_file, "keyAlias")
  store_file = production_android_signing_property(properties_file, "storeFile")
  if key_alias.to_s.empty? || store_file.to_s.empty?
    UI.user_error!("keyAlias and storeFile are required in #{properties_file}")
  end

  resolved_store_file = File.expand_path(store_file, File.join(ROOT_DIR, "android", "app"))
  UI.user_error!("Keystore file not found: #{resolved_store_file}") unless File.file?(resolved_store_file)

  format_command = [
    "keytool", "-J-Duser.language=en", "-J-Duser.country=US",
    "-list", "-keystore", resolved_store_file, "-storepass", password
  ]
  stdout, stderr, status = Open3.capture3(*format_command)
  UI.user_error!("Invalid keystore password for #{flavor}.") unless status.success?
  unless "#{stdout}\n#{stderr}".match?(/^Keystore type: PKCS12\s*$/i)
    UI.user_error!("The #{flavor} keystore must use the PKCS12 format.")
  end

  alias_command = [
    "keytool", "-J-Duser.language=en", "-J-Duser.country=US",
    "-list", "-keystore", resolved_store_file, "-alias", key_alias, "-storepass", password
  ]
  _, _, alias_status = Open3.capture3(*alias_command)
  UI.user_error!("Key alias #{key_alias} was not found for #{flavor}.") unless alias_status.success?
rescue Errno::ENOENT
  UI.user_error!("keytool was not found. Install a JDK and try again.")
end

def prepare_android_production(flavor:, opts:)
  platform_ = "aos"
  package = ANDROID_PACKAGES.fetch(flavor)
  skip_prep = UtilHelper.truthy?(opts[:skip_prep] || ENV["SKIP_PREP"])
  skip_clean = UtilHelper.truthy?(opts[:skip_clean] || ENV["SKIP_CLEAN"])
  skip_pubget = UtilHelper.truthy?(opts[:skip_pubget] || ENV["SKIP_PUBGET"])

  marketing, old_build = PubspecHelper.version_tuple_for(platform: platform_, flavor: flavor)
  new_build = old_build + 1
  metadata_path = ProductionReleaseHelper.validate_metadata!(
    root: ROOT_DIR,
    platform: "android",
    flavor: flavor,
    version_code: new_build
  )

  password = UI.password(prompt: "Keystore/key password: ")
  UI.user_error!("Keystore/key password cannot be empty.") if password.empty?
  validate_production_android_signing_password(flavor: flavor, password: password)
  ENV["ANDROID_SIGNING_STORE_PASSWORD"] = password
  ENV["ANDROID_SIGNING_KEY_PASSWORD"] = password

  begin
    prep_cmds = []
    prep_cmds << "fvm flutter clean" unless skip_prep || skip_clean
    prep_cmds << "fvm flutter pub get" unless skip_prep || skip_pubget
    dart_define = flavor == "mainnet" ? " --dart-define=USE_FIREBASE=true" : ""

    sh <<~SHELL
      cd #{Shellwords.escape(ROOT_DIR)} &&
      #{prep_cmds.empty? ? "true" : prep_cmds.join(" &&\n") } &&
      fvm flutter build appbundle \
        --flavor #{flavor} \
        --release#{dart_define} \
        --build-name=#{Shellwords.escape(marketing)} \
        --build-number=#{new_build}
    SHELL

    aab_path = Dir[File.join(ROOT_DIR, "build", "app", "outputs", "bundle", "#{flavor}Release", "*.aab")]
      .max_by { |path| File.mtime(path) }
    UI.user_error!("AAB not found for #{flavor}.") unless aab_path

    upload_to_play_store(
      aab: aab_path,
      package_name: package,
      json_key: File.join(ROOT_DIR, "android", "fastlane", "coconut-fastlane-supply.json"),
      track: "production",
      release_status: "draft",
      changes_not_sent_for_review: true,
      metadata_path: metadata_path,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    PubspecHelper.update_pubspec_build_number(
      platform: platform_,
      flavor: flavor,
      marketing: marketing,
      old_build: old_build,
      new_build: new_build
    )
  rescue => error
    UI.error("Android production preparation failed: #{error.message}")
    UI.important("pubspec.yaml was not updated because production preparation failed.")
    raise
  ensure
    ENV.delete("ANDROID_SIGNING_STORE_PASSWORD")
    ENV.delete("ANDROID_SIGNING_KEY_PASSWORD")
  end
end

platform :android do
  desc "Build Android MAINNET and create an unsubmitted production draft with localized release notes"
  lane :prepare_android_mainnet_production do |opts|
    prepare_android_production(flavor: "mainnet", opts: opts || {})
  end

  desc "Build Android REGTEST and create an unsubmitted production draft with localized release notes"
  lane :prepare_android_regtest_production do |opts|
    prepare_android_production(flavor: "regtest", opts: opts || {})
  end
end
